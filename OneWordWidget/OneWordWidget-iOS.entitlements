<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS half of the widget's entitlements, selected by CODE_SIGN_ENTITLEMENTS[sdk=iphone*].
	     Must match OneWord-iOS.entitlements exactly or the app and widget stop sharing. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hariom.swift.oneword</string>
	</array>
</dict>
</plist>
