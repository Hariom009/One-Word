<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only what GENERATE_INFOPLIST_FILE can't express. Both keys below are arrays
	     of dicts, so neither has an INFOPLIST_KEY_* equivalent — same reason the widget
	     target carries its own plist for NSExtension. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Save to One Word</string>
			</dict>
			<key>NSMessage</key>
			<string>saveWord</string>
			<key>NSPortName</key>
			<string>One Word</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
				<string>NSStringPboardType</string>
			</array>
		</dict>
	</array>
	<!-- GoogleSignIn's OAuth redirect is <REVERSED_CLIENT_ID>:/oauth2callback
	     (GIDSignIn.m:750). It checks the registered schemes before starting the flow and
	     raises NSInvalidArgumentException if this is missing (:588) — a crash, not an
	     error. Value is REVERSED_CLIENT_ID from GoogleService-Info.plist, verbatim. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.554130091393-qnbo6l4103q98ums563v0douva9d749h</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
