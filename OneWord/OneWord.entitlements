<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>LAP54KU2SV.group.com.hariom.swift.oneword</string>
	</array>
	<!-- Firebase Auth and the ASWebAuthenticationSession that GoogleSignIn opens both
	     reach the network. Without this the sandbox blocks every request and sign-in
	     hangs with no error. Outbound only — the OAuth browser runs out of process. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- FirebaseAuth writes its session with kSecUseDataProtectionKeychain = true
	     (AuthKeychainServices.swift:232). On macOS the data-protection keychain refuses
	     an app with no keychain-access-group: SecItemAdd returns -34018 and the session
	     never survives a relaunch. This is the "Keychain Sharing" capability. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.hariom.swift.oneword</string>
	</array>
</dict>
</plist>
