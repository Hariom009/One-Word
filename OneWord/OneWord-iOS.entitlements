<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS half of the app's entitlements, selected by CODE_SIGN_ENTITLEMENTS[sdk=iphone*].
	     No sandbox key and no network entitlement: both are macOS-only. The App Group id
	     is group.-prefixed because iOS refuses any other shape (see AppGroup.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.hariom.swift.oneword</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.hariom.swift.oneword</string>
	</array>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
